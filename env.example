# Public site URL
VITE_SITE_URL=https://example.com
# WhatsApp number in international format, digits only
VITE_WHATSAPP_NUMBER=2348000000000
# Configurable starter price displays
VITE_STARTER_PRICE_USD=20
VITE_STARTER_PRICE_NAIRA=30000
# Hosted secure checkout URL; never put secret API keys in VITE variables
VITE_PAYMENT_URL=https://checkout.example.com/your-hosted-payment-link
# HTTPS endpoint that accepts order JSON when Supabase is not configured
VITE_ORDER_ENDPOINT=https://formspree.io/f/your-form-id

# Supabase public browser configuration for the private admin panel
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
